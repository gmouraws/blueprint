{
  "name": "blueprint",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.17.0 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && tsx scripts/verify-output.ts",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --conditions=react-server --import tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:transport": "playwright test --config playwright.transport.config.ts",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {
    "@livekit/components-react": "2.9.24",
    "@upstash/ratelimit": "2.2.0",
    "@upstash/redis": "1.39.0",
    "jose": "6.2.13",
    "livekit-client": "2.22.0",
    "livekit-server-sdk": "2.19.1",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
