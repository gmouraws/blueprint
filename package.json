{
  "name": "blueprint",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.17.0 <23"
  },
  "scripts": {
    "predev": "npm run content:check",
    "pretest": "npm run content:check",
    "dev": "next dev",
    "build": "tsx scripts/validate-content.ts && next build && tsx scripts/verify-output.ts",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "content:check": "tsx scripts/validate-content.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm run content:check && npm test"
  },
  "dependencies": {
    "@vercel/analytics": "2.0.1",
    "next": "16.4.0",
    "next-mdx-remote": "6.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rehype-highlight": "7.0.2",
    "rehype-slug": "6.0.0",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
