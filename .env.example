# Server-only. Replace placeholders in .env.local; never commit real values.
APP_ORIGIN=http://localhost:3000
# HMAC key for Redis identifiers; separate from Better Auth.
SESSION_SECRET=replace-with-at-least-32-random-bytes-generated-locally
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=replace-with-project-api-key
LIVEKIT_API_SECRET=replace-with-project-api-secret
LIVEKIT_ROOM_NAME=blueprint-room-preview
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-with-database-rest-token
# Neon Marketplace supplies DATABASE_URL per Vercel environment. Never use production locally.
DATABASE_URL=postgresql://replace-with-user:replace-with-password@your-project.neon.tech/neondb?sslmode=require
# Local tools only; deployed requests use the Vercel-provided VERCEL_ENV.
CHAT_ENVIRONMENT=development
CRON_SECRET=replace-with-at-least-32-random-bytes-for-cleanup-only

# Private Blob store: use a separate Preview store; never expose the read-write token.
BLOB_READ_WRITE_TOKEN=replace-with-private-store-token
# Must match VERCEL_ENV (or local CHAT_ENVIRONMENT).
BLOB_ENVIRONMENT=development

# Invite-only accounts. Separate credentials/sender configuration for Preview and Production.
BETTER_AUTH_SECRET=replace-with-at-least-32-random-bytes-for-accounts
RESEND_API_KEY=replace-with-preview-only-resend-api-key
RESEND_FROM=room@verified-sender.example
# One-off server-side owner invitation only; do not expose or commit a real address.
# BOOTSTRAP_OWNER_EMAIL=owner@example.test

# Optional guest-space Discord announcements: leave disabled until destination is authorized.
DISCORD_STREAM_ANNOUNCEMENTS_ENABLED=false
DISCORD_STREAM_WEBHOOK_URL=

# Optional HTTP slash command (server-only). Missing configuration fails closed without affecting rooms.
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
DISCORD_GUILD_ID=
# Comma-separated exact channel IDs; no wildcard or automatic thread inheritance.
DISCORD_ALLOWED_CHANNEL_IDS=
# Local registration script only; do not add this token to Vercel or browser configuration.
# DISCORD_BOT_TOKEN=
